{
  "dataset": "transportasi_jabodetabek_normalized",
  "version": "2026-07-26",
  "description": "Dataset awal ter-normalisasi untuk SPK SAW transportasi Jabodetabek. Data lokasi yang belum diekstrak lokal diarahkan ke sumber JSON resmi GIS DKI agar tidak mengarang koordinat/rute.",
  "schema": {
    "id": "string",
    "moda": "string",
    "nama": "string",
    "jenis": "string",
    "latitude": "number|null",
    "longitude": "number|null",
    "koridor": "string|null",
    "asal": "string|null",
    "tujuan": "string|null",
    "harga": "number|null",
    "waktu_menit": "number|null",
    "sumber": "string",
    "status_data": "verified|api_source|needs_route_query"
  },
  "sources": {
    "gis_dki": {
      "type": "ArcGIS REST JSON/GeoJSON",
      "url": "https://gis-dpmptsp.jakarta.go.id/arcgis/rest/services/Hosted/Titik_Transportasi_Umum_Jakarta_v3/FeatureServer/26",
      "use_for": [
        "KRL",
        "MRT Jakarta",
        "LRT Jabodebek",
        "TransJakarta"
      ],
      "note": "Layer resmi DKI memiliki field nama, koridor, fungsi, jenis, lat, long dan mendukung JSON/GeoJSON."
    },
    "mrt_jakarta": {
      "type": "official website",
      "url": "https://jakartamrt.co.id/id/daftar-stasiun",
      "use_for": [
        "MRT Jakarta"
      ]
    },
    "lrt_jabodebek": {
      "type": "official website",
      "url": "https://lrtjabodebek.kai.id/informasi-tarif",
      "use_for": [
        "LRT Jabodebek"
      ]
    },
    "transjakarta_gtfs": {
      "type": "GTFS",
      "url": "https://gtfs.transjakarta.co.id/files/file_gtfs.zip",
      "use_for": [
        "TransJakarta",
        "Mikrotrans/JakLingko"
      ]
    },
    "jaklingko": {
      "type": "official website",
      "url": "https://jaklingkoindonesia.co.id/",
      "use_for": [
        "JakLingko",
        "integrasi tarif"
      ]
    },
    "krl": {
      "type": "official website",
